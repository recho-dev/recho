rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Notebooks are stored by id. Public notebooks can be read by anyone with
    // the link. Only the owner can read private notebooks or write any of them.
    match /notebooks/{notebookId} {
      function isValid() {
        return isUser(request.resource.data.ownerId)
          && request.resource.data.visibility in ["private", "public"];
      }

      allow read: if resource.data.visibility == "public" || isUser(resource.data.ownerId);
      allow create: if isValid();
      allow update: if isUser(resource.data.ownerId) && isValid();
      allow delete: if isUser(resource.data.ownerId);
    }
  }
}
