# Copy to .env.local and fill in from the Firebase web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Where notebooks run: the runtime page (pnpm runtime:dev serves it at
# http://127.0.0.1:5174). Leave it empty in development to run notebooks in
# the page itself. Production uses https://recho-runtime.vercel.app unless set.
NEXT_PUBLIC_RUNTIME_ORIGIN=
